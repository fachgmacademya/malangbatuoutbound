---
import type { PackageItem } from '../data/packages';
import { getWhatsAppUrl } from '../data/site';

export interface Props {
  pkg: PackageItem;
}

const { pkg } = Astro.props;
const waLink = getWhatsAppUrl(pkg.whatsappMessage);
---

<div class="col-12 col-md-6 col-lg-4 mb-4">
  <div class="mbo-card">
    <!-- Card Media -->
    <div class="position-relative overflow-hidden bg-light" style="aspect-ratio: 16/10;">
      <img
        src={pkg.image}
        alt={pkg.alt}
        width="700"
        height="450"
        loading="lazy"
        class="w-100 h-100 object-fit-cover"
      />
      {pkg.badge && (
        <span class="position-absolute top-0 start-0 m-3 badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill shadow-sm">
          {pkg.badge}
        </span>
      )}
      <span class="position-absolute bottom-0 start-0 m-3 badge bg-dark bg-opacity-75 text-white fw-semibold px-2.5 py-1.5 rounded-3">
        {pkg.category}
      </span>
    </div>

    <!-- Card Content -->
    <div class="card-body p-4 d-flex flex-column flex-grow-1">
      <h3 class="h5 fw-bold mb-2 text-dark">{pkg.title}</h3>
      <p class="small text-muted mb-3 flex-grow-1">{pkg.summary}</p>

      <!-- Target Audience -->
      <div class="p-2.5 mb-3 rounded-3 bg-light border border-light">
        <div class="d-flex align-items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="var(--color-secondary-blue)" class="mt-1 flex-shrink-0" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
          </svg>
          <div class="small">
            <strong class="text-dark">Sasaran:</strong> <span class="text-secondary">{pkg.targetAudience}</span>
          </div>
        </div>
      </div>

      <!-- Key Activities Preview -->
      <div class="mb-4">
        <div class="small fw-bold text-dark mb-1.5">Aktivitas Utama:</div>
        <ul class="list-unstyled mb-0 small text-muted">
          {pkg.activities.slice(0, 3).map((act) => (
            <li class="d-flex align-items-center gap-1.5 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="var(--color-secondary-blue)" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
              </svg>
              <span>{act}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Action Button -->
      <div class="mt-auto pt-2">
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-mbo-whatsapp w-100 py-2.5 small"
          aria-label={`Tanyakan detail paket ${pkg.title} via WhatsApp (buka tab baru)`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
          </svg>
          <span>Tanyakan Detail Program</span>
        </a>
      </div>
    </div>
  </div>
</div>

